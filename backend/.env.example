# Copy to .env and fill in. .env is git-ignored — never commit real values.

# CarSky platform API base URL (docs/Car-Sky-Platform.html, base path /api/v1).
# UNCONFIRMED: docs/link.md only records the web UI host
# (https://hackathon-2.carsky.io/). Verify with a teammate who already has a
# working credential, or check GET /api/v1/openapi, before trusting this default.
CARSKY_BASE_URL=https://hackathon-2.carsky.io/api/v1

# Personal API token, sent as "Authorization: Bearer <token>".
# Get this from your CarSky account — do not share it in chat/commits.
CARSKY_API_TOKEN=

# Default room/deployment id, used when --room is not passed explicitly to
# `viva-tools carsky nodes` / `viva-tools carsky adb-tunnel`.
CARSKY_ROOM_ID=

# Per-request HTTP timeout in seconds. Optional — defaults to 30 if unset.
# Raise this if the CarSky VM is slow to respond under load (cold container,
# VM restart in progress).
CARSKY_TIMEOUT_SECONDS=30
